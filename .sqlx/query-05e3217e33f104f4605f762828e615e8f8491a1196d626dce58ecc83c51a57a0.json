{
  "db_name": "PostgreSQL",
  "query": "SELECT DISTINCT ON (c.number_milli) c.series_source_id, c.number_milli, c.title, chapter_url_path(ss.source_path, c.path) AS \"path!\", c.published_at, c.discovered_at FROM chapters c JOIN series_sources ss ON ss.id = c.series_source_id WHERE c.series_source_id = ANY($1) AND (c.access = 'free' OR c.unlocks_at <= now() OR ss.provider_id = ANY(ARRAY( SELECT e.provider_id FROM user_provider_early_access e WHERE e.user_id = $2::uuid))) ORDER BY c.number_milli DESC, c.discovered_at ASC",

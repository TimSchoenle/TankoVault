{
  "db_name": "PostgreSQL",
  "query": "UPDATE scan_runs SET state = CASE WHEN done_tasks = 0 AND failed_tasks > 0 THEN 'failed'::run_state ELSE 'completed'::run_state END, finished_at = now() WHERE id = $1 AND state = 'running' AND total_tasks > 0 AND (done_tasks + failed_tasks) >= total_tasks RETURNING id, provider_id, mode AS \"mode: ScanMode\", state AS \"state: RunState\", total_tasks, done_tasks, failed_tasks, started_at, finished_at, created_at",

{
  "db_name": "PostgreSQL",
  "query": "SELECT ea.user_id, u.username, ea.provider, ea.external_username, ea.last_synced_at, ea.last_error, ea.auto_sync_enabled, ea.conflict_policy, (SELECT count(*) FROM sync_conflicts sc WHERE sc.user_id = ea.user_id AND sc.resolved_at IS NULL) AS \"pending_conflicts!\", ea.created_at FROM external_accounts ea JOIN users u ON u.id = ea.user_id ORDER BY (ea.last_error IS NOT NULL) DESC, ea.last_synced_at DESC NULLS LAST LIMIT $1",

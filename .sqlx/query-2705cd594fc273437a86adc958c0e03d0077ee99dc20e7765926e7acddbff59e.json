  "query": "SELECT h.id, h.series_id, s.canonical_title AS series_title, h.provider, h.action, h.detail AS \"detail: Json\", h.created_at FROM sync_history h JOIN series s ON s.id = h.series_id WHERE h.user_id = $1 AND ($2::uuid IS NULL OR h.series_id = $2) AND ($3::text IS NULL OR h.provider = $3) ORDER BY h.created_at DESC LIMIT $4 OFFSET $5",

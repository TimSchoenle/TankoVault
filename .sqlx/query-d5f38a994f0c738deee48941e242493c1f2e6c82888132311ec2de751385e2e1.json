{
  "db_name": "PostgreSQL",
  "query": "WITH matched AS ( SELECT s.id, similarity(s.normalized_title, $1) AS sim FROM series s WHERE s.normalized_title % $1 UNION ALL SELECT st.series_id, similarity(st.normalized, $1) FROM series_titles st WHERE st.normalized % $1 ), ranked AS ( SELECT m.id, max(m.sim) AS sim FROM matched m GROUP BY m.id ORDER BY sim DESC LIMIT $2 ) SELECT s.id AS series_id, s.canonical_title AS title, s.normalized_title, s.content_type::text AS \"content_type!\", s.release_year, (SELECT count(*) FROM series_sources ss WHERE ss.series_id = r.id) AS \"source_count!\", r.sim AS \"similarity!\" FROM ranked r JOIN series s ON s.id = r.id ORDER BY r.sim DESC",

  "db_name": "PostgreSQL",
  "query": "SELECT s.id AS series_id, s.canonical_title AS title, s.normalized_title, s.content_type::text AS \"content_type!\", s.release_year, (SELECT count(*) FROM series_sources ss WHERE ss.series_id = s.id) AS \"source_count!\", GREATEST( similarity(s.normalized_title, $1), COALESCE((SELECT MAX(similarity(st.normalized, $1)) FROM series_titles st WHERE st.series_id = s.id), 0) ) AS \"similarity!\" FROM series s WHERE s.normalized_title % $1 OR EXISTS (SELECT 1 FROM series_titles st WHERE st.series_id = s.id AND st.normalized % $1) ORDER BY 7 DESC LIMIT $2",

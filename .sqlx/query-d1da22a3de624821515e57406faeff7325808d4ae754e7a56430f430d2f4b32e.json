  "query": "SELECT re.user_id, u.username, re.provider, re.external_id, re.title, re.status, re.progress, re.content_type, re.start_year FROM sync_remote_entries re JOIN users u ON u.id = re.user_id WHERE re.series_id IS NULL AND re.provider = $1 AND ($2::text IS NULL OR re.title ILIKE $2) ORDER BY re.title LIMIT $3",

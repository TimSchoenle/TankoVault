{
  "db_name": "PostgreSQL",
  "query": "WITH matched AS ( SELECT a.* FROM audit_log a WHERE ($1::uuid IS NULL OR a.actor_id = $1) AND ($2::text IS NULL OR a.action = $2) AND ($3::text IS NULL OR a.target ILIKE '%' || $3 || '%') AND ($4::timestamptz IS NULL OR a.created_at >= $4) AND ($5::timestamptz IS NULL OR a.created_at < $5) ) SELECT m.id, u.username AS \"actor?\", m.action, m.target, m.detail, m.created_at, (SELECT count(*) FROM matched) AS \"total!\" FROM matched m LEFT JOIN users u ON u.id = m.actor_id ORDER BY m.created_at DESC LIMIT $6 OFFSET $7",

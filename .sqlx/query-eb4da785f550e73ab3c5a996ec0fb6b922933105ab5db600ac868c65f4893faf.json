{
  "db_name": "PostgreSQL",
  "query": "SELECT ss.series_id AS \"series_id!\", p.slug AS \"code!\", p.name AS \"name!\", CASE WHEN p.state <> 'active' THEN p.state ELSE ss.state END AS \"state!: ProviderState\", (row_number() OVER (PARTITION BY ss.series_id ORDER BY ss.chapter_count DESC, ss.last_scanned_at DESC NULLS LAST, p.slug) = 1) AS \"preferred!\" FROM series_sources ss JOIN providers p ON p.id = ss.provider_id WHERE ss.series_id = ANY($1) ORDER BY ss.series_id, ss.chapter_count DESC, ss.last_scanned_at DESC NULLS LAST, p.slug",

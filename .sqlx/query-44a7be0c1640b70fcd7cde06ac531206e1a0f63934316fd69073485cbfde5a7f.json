{
  "db_name": "PostgreSQL",
  "query": "SELECT w.series_id, w.status AS \"status: WatchStatus\", COALESCE(floor(rp.last_read_whole_number), 0)::int8 AS \"chapters_read!\", GREATEST(w.updated_at, COALESCE(rp.updated_at, w.updated_at)) AS \"observed_at!\", (EXTRACT(EPOCH FROM (now() - GREATEST(w.updated_at, COALESCE(rp.updated_at, w.updated_at)))) / 86400.0)::float8 AS \"age_days!\" FROM watchlist_entries w LEFT JOIN read_progress rp ON rp.user_id = w.user_id AND rp.series_id = w.series_id WHERE w.user_id = $1",

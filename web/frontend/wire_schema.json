{
  "$defs": {
    "AdapterKind": {
      "description": "Which adapter implementation drives a provider.",
      "enum": [
        "madara",
        "generic_config",
        "custom"
      ],
      "type": "string"
    },
    "AdminAccountRow": {
      "description": "One row of the admin Sync console's \"Linked accounts\" table. The automatic-sync policy\ncolumns and pending-conflict count (design v2 §B.7) are read-only operator visibility —\nthey are user settings, never operator-overridable.",
      "properties": {
        "auto_sync_enabled": {
          "type": "boolean"
        },
        "conflict_policy": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "external_username": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_synced_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending_conflicts": {
          "format": "int64",
          "type": "integer"
        },
        "provider": {
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "username",
        "provider",
        "auto_sync_enabled",
        "conflict_policy",
        "pending_conflicts",
        "created_at"
      ],
      "type": "object"
    },
    "AdminMappingRow": {
      "description": "One row of the admin Sync console's \"Series mappings\" table.",
      "properties": {
        "external_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "series_id": {
          "format": "uuid",
          "type": "string"
        },
        "series_title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "series_id",
        "series_title",
        "provider",
        "external_id",
        "updated_at"
      ],
      "type": "object"
    },
    "AssignRemoteEntry": {
      "properties": {
        "external_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "series_id": {
          "$ref": "#/$defs/SeriesId"
        },
        "user_id": {
          "$ref": "#/$defs/UserId"
        }
      },
      "required": [
        "user_id",
        "provider",
        "external_id",
        "series_id"
      ],
      "type": "object"
    },
    "AuditView": {
      "description": "One privileged-action record enriched with the actor's username, for the console feed.",
      "properties": {
        "action": {
          "type": "string"
        },
        "actor": {
          "description": "Actor username (`None` for system-originated actions or a since-deleted user).",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "detail": {
          "$ref": "#/$defs/Value"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "action",
        "detail",
        "created_at"
      ],
      "type": "object"
    },
    "Author": {
      "description": "An author/artist credit.",
      "properties": {
        "id": {
          "$ref": "#/$defs/AuthorId"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "name"
      ],
      "type": "object"
    },
    "AuthorId": {
      "description": "Identifies an author/artist credit.",
      "format": "uuid",
      "type": "string"
    },
    "ChapterDto": {
      "properties": {
        "number": {
          "format": "double",
          "type": "number"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "read": {
          "description": "Whether the requesting user has read this chapter (number ≤ their progress).\n`None` for anonymous requests; `Some(bool)` when a valid `Bearer` token is present\n(frontend §9.2 auth-scoped read-state).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Resolved absolute URL to open the chapter page on the provider.",
          "type": "string"
        }
      },
      "required": [
        "number",
        "url"
      ],
      "type": "object"
    },
    "ChapterId": {
      "description": "Identifies a [`crate::entities::Chapter`].",
      "format": "uuid",
      "type": "string"
    },
    "ChapterRead": {
      "properties": {
        "read": {
          "type": "boolean"
        }
      },
      "required": [
        "read"
      ],
      "type": "object"
    },
    "ContentType": {
      "description": "The medium/origin classification of a work.",
      "enum": [
        "manga",
        "manhwa",
        "manhua",
        "webtoon",
        "unknown"
      ],
      "type": "string"
    },
    "ContinueItem": {
      "properties": {
        "cover_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_read_number": {
          "format": "double",
          "type": "number"
        },
        "next_number": {
          "description": "The lowest unread chapter number above the user's progress, if any.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "series_id": {
          "$ref": "#/$defs/SeriesId"
        },
        "series_title": {
          "type": "string"
        },
        "unread": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "series_id",
        "series_title",
        "last_read_number",
        "unread"
      ],
      "type": "object"
    },
    "CreateProvider": {
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterKind"
        },
        "base_url": {
          "type": "string"
        },
        "config": {},
        "name": {
          "type": "string"
        },
        "politeness": {
          "$ref": "#/$defs/Politeness"
        },
        "slug": {
          "type": "string"
        }
      },
      "required": [
        "slug",
        "name",
        "base_url",
        "adapter"
      ],
      "type": "object"
    },
    "DismissRequest": {
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "FailedTaskView": {
      "description": "A failed scan task enriched with its run's provider + mode, for the console error feed.",
      "properties": {
        "attempts": {
          "format": "int32",
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "provider_slug": {
          "description": "Provider slug of the owning run (`None` if the provider was since deleted).",
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "mode",
        "kind",
        "attempts"
      ],
      "type": "object"
    },
    "FeedEntry": {
      "properties": {
        "chapter_number": {
          "format": "double",
          "type": "number"
        },
        "chapter_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "discovered_at": {
          "type": "string"
        },
        "provider_slug": {
          "type": "string"
        },
        "series_id": {
          "$ref": "#/$defs/SeriesId"
        },
        "series_title": {
          "type": "string"
        },
        "url": {
          "description": "Ready-to-open absolute URL, resolved from the provider base + relative path.",
          "type": "string"
        }
      },
      "required": [
        "series_id",
        "series_title",
        "chapter_number",
        "provider_slug",
        "url",
        "discovered_at"
      ],
      "type": "object"
    },
    "LoginRequest": {
      "properties": {
        "login": {
          "description": "Email or username.",
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "required": [
        "login",
        "password"
      ],
      "type": "object"
    },
    "MarkRead": {
      "properties": {
        "ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "ids"
      ],
      "type": "object"
    },
    "MarkReadTo": {
      "properties": {
        "number": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "number"
      ],
      "type": "object"
    },
    "MeStats": {
      "description": "Lifetime reading stats for the Home/Profile headline (frontend §9.3 `GET /v1/me/stats`).\n`chapters_read` is the sum of whole chapters below each series' last-read marker — an\nhonest proxy over stored progress (there is no per-chapter read-event log, so a daily\n\"streak\" is intentionally omitted rather than fabricated).",
      "properties": {
        "chapters_read": {
          "format": "int64",
          "type": "integer"
        },
        "completed": {
          "format": "int64",
          "type": "integer"
        },
        "reading": {
          "format": "int64",
          "type": "integer"
        },
        "tracking": {
          "format": "int64",
          "type": "integer"
        },
        "unread": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "tracking",
        "reading",
        "completed",
        "chapters_read",
        "unread"
      ],
      "type": "object"
    },
    "MergeCandidateView": {
      "description": "A pending merge candidate enriched with both series' display titles, for the operator\nreview queue (design §11 `GET /v1/admin/merge-candidates`).",
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/SeriesId"
        },
        "candidate_title": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "format": "float",
          "type": "number"
        },
        "series_id": {
          "$ref": "#/$defs/SeriesId"
        },
        "series_title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "series_id",
        "series_title",
        "candidate_id",
        "candidate_title",
        "score",
        "created_at"
      ],
      "type": "object"
    },
    "MergeRequest": {
      "properties": {
        "keep": {
          "$ref": "#/$defs/SeriesId",
          "description": "The surviving canonical series."
        },
        "merge": {
          "$ref": "#/$defs/SeriesId",
          "description": "The series merged into `keep` and then deleted."
        }
      },
      "required": [
        "keep",
        "merge"
      ],
      "type": "object"
    },
    "NotificationId": {
      "description": "Identifies a notification.",
      "format": "uuid",
      "type": "string"
    },
    "Politeness": {
      "description": "Crawl politeness parameters for one provider.",
      "properties": {
        "concurrency": {
          "description": "Maximum concurrent requests to this provider.",
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "crawl_delay_ms": {
          "description": "Minimum delay between requests, in milliseconds (from robots crawl-delay or config).",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "rps": {
          "description": "Requests per second, aggregate across the worker pool.",
          "format": "double",
          "type": "number"
        },
        "user_agent": {
          "description": "User-agent sent on ordinary (non-challenge) requests.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ProblemDetails": {
      "description": "RFC 9457 `application/problem+json` error body shape produced by [`ApiError`]. Declared\npurely for `OpenAPI` documentation — [`ApiError::into_response`] builds the JSON by hand so\nruntime callers never construct this type.",
      "example": {
        "detail": "resource not found",
        "status": 404,
        "title": "not_found",
        "type": "about:blank#not_found"
      },
      "properties": {
        "detail": {
          "type": "string"
        },
        "status": {
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "detail"
      ],
      "type": "object"
    },
    "ProfileDto": {
      "properties": {
        "email": {
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "email",
        "username",
        "role"
      ],
      "type": "object"
    },
    "ProfileUpdate": {
      "properties": {
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ProgressDto": {
      "properties": {
        "last_read_part_number": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "last_read_whole_number": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "last_read_whole_number"
      ],
      "type": "object"
    },
    "ProgressUpdate": {
      "properties": {
        "last_read_whole_number": {
          "description": "The whole-chapter frontier to set outright (design v2 §A.6 — renamed from\n`last_read_number`, same semantics).",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "last_read_whole_number"
      ],
      "type": "object"
    },
    "Provider": {
      "description": "A source site. The single place a domain (`base_url`) is defined.",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterKind"
        },
        "base_url": {
          "description": "The domain root. Changing this one field migrates every stored link.",
          "type": "string"
        },
        "config": {
          "description": "Adapter selector/pagination config (shape depends on `adapter`)."
        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ProviderId"
        },
        "last_full_scan_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "politeness": {
          "$ref": "#/$defs/Politeness"
        },
        "robots_at": {
          "description": "Wire shape is a plain string (whatever `time`'s serde impl emits), never parsed\nclient-side — kept untyped here so the generated frontend type doesn't need a date\ncrate (mirrors the `no date crate in the bundle` constraint on the other timestamp\nfields below).",
          "type": [
            "string",
            "null"
          ]
        },
        "robots_txt": {
          "type": [
            "string",
            "null"
          ]
        },
        "slug": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ProviderState"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "base_url",
        "adapter",
        "config",
        "state",
        "politeness",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "ProviderId": {
      "description": "Identifies a [`crate::entities::Provider`].",
      "format": "uuid",
      "type": "string"
    },
    "ProviderStat": {
      "description": "One row of the per-provider statistics table. Enum columns are text-cast; the provider's\nidentity fields are joined in so the console renders the table from one fetch.",
      "properties": {
        "adapter": {
          "description": "Adapter implementation token (`madara` | `generic_config` | `custom`).",
          "type": "string"
        },
        "blocked_sources": {
          "description": "Source links currently in a non-active state.",
          "format": "int64",
          "type": "integer"
        },
        "chapter_count": {
          "format": "int64",
          "type": "integer"
        },
        "chapters_24h": {
          "format": "int64",
          "type": "integer"
        },
        "chapters_7d": {
          "format": "int64",
          "type": "integer"
        },
        "last_chapter_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_full_scan_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_run_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_run_state": {
          "description": "State of the provider's most recent scan run, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "last_scanned_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "provider_id": {
          "format": "uuid",
          "type": "string"
        },
        "series_count": {
          "description": "Distinct series that have at least one source on this provider.",
          "format": "int64",
          "type": "integer"
        },
        "slug": {
          "type": "string"
        },
        "source_count": {
          "description": "Source links (series ↔ provider joins) this provider owns.",
          "format": "int64",
          "type": "integer"
        },
        "state": {
          "description": "Provider health state token (`active` | `disabled` | `blocked` | …).",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "slug",
        "name",
        "state",
        "adapter",
        "series_count",
        "source_count",
        "blocked_sources",
        "chapter_count",
        "chapters_24h",
        "chapters_7d"
      ],
      "type": "object"
    },
    "ProviderState": {
      "description": "Live health state of a provider (drives the circuit breaker + console tiles).",
      "enum": [
        "active",
        "degraded",
        "challenged",
        "solving",
        "blocked",
        "disabled"
      ],
      "type": "string"
    },
    "PublicProvider": {
      "description": "A public-facing provider entry for the Discover filter list (frontend §9.3\n`GET /v1/providers`): identity plus how many distinct series it carries, so the UI can\nshow \"Provider (N)\" options without exposing operator-only config/politeness.",
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "series_count": {
          "description": "Distinct canonical series with at least one source on this provider.",
          "format": "int64",
          "type": "integer"
        },
        "slug": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "series_count"
      ],
      "type": "object"
    },
    "RegisterRequest": {
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "email",
        "username",
        "password"
      ],
      "type": "object"
    },
    "RemoteEntryRow": {
      "description": "One row of the admin console's \"Unmatched remote entries\" queue: a fetched provider entry\nthe auto-matcher could not confidently link to a local series.",
      "properties": {
        "content_type": {
          "type": "string"
        },
        "external_id": {
          "type": "string"
        },
        "progress": {
          "format": "double",
          "type": "number"
        },
        "provider": {
          "type": "string"
        },
        "start_year": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "username",
        "provider",
        "external_id",
        "title",
        "status",
        "progress",
        "content_type"
      ],
      "type": "object"
    },
    "ResolveConflict": {
      "properties": {
        "resolution": {
          "type": "string"
        }
      },
      "required": [
        "resolution"
      ],
      "type": "object"
    },
    "RunState": {
      "description": "Lifecycle of a scan run.",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "ScanMode": {
      "description": "Scan cadence.",
      "enum": [
        "full",
        "fast"
      ],
      "type": "string"
    },
    "ScanRun": {
      "description": "A scan run (progress + audit; mirrors `JetStream` dispatch).",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "done_tasks": {
          "format": "int32",
          "type": "integer"
        },
        "failed_tasks": {
          "format": "int32",
          "type": "integer"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/ScanRunId"
        },
        "mode": {
          "$ref": "#/$defs/ScanMode"
        },
        "provider_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ProviderId"
            }
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/RunState"
        },
        "total_tasks": {

  "query": "SELECT w.user_id, w.status AS \"status: WatchStatus\", u.notification_prefs AS \"prefs: Json\", rp.last_read_whole_number::float8 AS whole, rp.last_read_part_number::float8 AS part FROM watchlist_entries w JOIN users u ON u.id = w.user_id LEFT JOIN read_progress rp ON rp.user_id = w.user_id AND rp.series_id = w.series_id WHERE w.series_id = $1 AND w.notify",

  "query": "SELECT t.id, t.run_id, p.slug AS \"provider_slug?\", r.mode::text AS \"mode!\", t.kind, t.error, t.attempts, t.finished_at FROM scan_tasks t JOIN scan_runs r ON r.id = t.run_id LEFT JOIN providers p ON p.id = r.provider_id WHERE t.state = 'failed' ORDER BY t.finished_at DESC NULLS LAST LIMIT $1",

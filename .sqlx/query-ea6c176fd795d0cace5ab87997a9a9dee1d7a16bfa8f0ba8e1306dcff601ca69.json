{
  "db_name": "PostgreSQL",
  "query": "SELECT u.status AS \"status: AccountStatus\", coalesce(array_agg(p.permission) FILTER (WHERE p.permission IS NOT NULL), '{}'::text[]) AS \"permissions!\", (u.adult_opt_in AND u.age_attested_at IS NOT NULL) AS \"adult_opt_in!\" FROM users u LEFT JOIN user_permissions p ON p.user_id = u.id WHERE u.id = $1 GROUP BY u.status, u.adult_opt_in, u.age_attested_at",

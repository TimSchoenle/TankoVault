  "query": "SELECT r.id AS \"id!\", r.kind AS \"kind!: RequestKind\", r.status AS \"status!: RequestStatus\", r.detail, r.requested_at AS \"requested_at!\", r.due_at AS \"due_at!\", r.resolved_at, r.resolution_note, r.user_id, s.username AS \"username?: String\", s.email AS \"email?: String\", c.username AS \"claimed_by?: String\", v.username AS \"resolved_by?: String\", (r.status IN ('pending','in_progress') AND r.due_at < now()) AS \"overdue!\" FROM gdpr_requests r LEFT JOIN users s ON s.id = r.user_id LEFT JOIN users c ON c.id = r.claimed_by LEFT JOIN users v ON v.id = r.resolved_by WHERE r.id = $1",

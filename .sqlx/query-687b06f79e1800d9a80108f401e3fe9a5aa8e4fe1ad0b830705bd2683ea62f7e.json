  "db_name": "PostgreSQL",
  "query": "SELECT t.id, t.run_id, p.slug AS \"provider_slug?\", t.kind, t.state AS \"state: TaskState\", t.target AS \"target: Json\", t.error, t.attempts, t.finished_at FROM scan_tasks t JOIN scan_runs r ON r.id = t.run_id LEFT JOIN providers p ON p.id = r.provider_id WHERE r.state IN ('queued','running') AND t.finished_at IS NOT NULL ORDER BY t.finished_at DESC LIMIT $1",

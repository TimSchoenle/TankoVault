  "query": "SELECT c.id, c.series_id, s.canonical_title AS series_title, c.provider, c.field, c.local_value, c.remote_value, c.detected_at FROM sync_conflicts c JOIN series s ON s.id = c.series_id WHERE c.user_id = $1 AND c.resolved_at IS NULL ORDER BY c.detected_at DESC",

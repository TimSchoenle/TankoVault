  "query": "SELECT t.id, t.kind, t.target AS \"target: Json\", t.state AS \"state: TaskState\", t.attempts, t.worker_id, t.error, t.stage, t.stage_at, t.stage_done, t.stage_total, t.stage_detail, t.created_at, t.claimed_at, t.finished_at, t.wait_ms, t.duration_ms, t.telemetry AS \"telemetry: Json\" FROM scan_tasks t WHERE t.run_id = $1 ORDER BY (t.state = 'claimed') DESC, CASE WHEN $2::text = 'recent' THEN t.finished_at END DESC NULLS FIRST, t.duration_ms DESC NULLS LAST, t.created_at DESC NULLS LAST LIMIT $3",

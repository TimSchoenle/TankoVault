{
  "db_name": "PostgreSQL",
  "query": "SELECT mc.id, mc.series_id, s1.canonical_title AS series_title, mc.candidate_id, s2.canonical_title AS candidate_title, mc.score, mc.signals, mc.reason, mc.created_at, mc.updated_at, (SELECT count(*) FROM series_sources ss WHERE ss.series_id = s1.id) AS \"series_sources!\", (SELECT count(*) FROM series_sources ss WHERE ss.series_id = s2.id) AS \"candidate_sources!\", COALESCE((SELECT sum(ss.chapter_count) FROM series_sources ss WHERE ss.series_id = s1.id), 0) AS \"series_chapters!\", COALESCE((SELECT sum(ss.chapter_count) FROM series_sources ss WHERE ss.series_id = s2.id), 0) AS \"candidate_chapters!\" FROM merge_candidates mc JOIN series s1 ON s1.id = mc.series_id JOIN series s2 ON s2.id = mc.candidate_id WHERE NOT mc.resolved AND mc.score >= $2 ORDER BY mc.score DESC, mc.created_at DESC LIMIT $1",

  "query": "SELECT t.id, t.slug, t.name, COALESCE(c.n, 0) AS \"series_count!\" FROM tags t LEFT JOIN (SELECT stg.tag_id, count(*) AS n FROM series_tags stg GROUP BY stg.tag_id) c ON c.tag_id = t.id ORDER BY COALESCE(c.n, 0) DESC, t.name",

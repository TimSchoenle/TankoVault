  "query": "UPDATE scan_tasks SET state = 'claimed', worker_id = $2, claimed_at = now(), attempts = attempts + 1 WHERE id = ( SELECT id FROM scan_tasks WHERE run_id = $1 AND state = 'queued' ORDER BY id FOR UPDATE SKIP LOCKED LIMIT 1 ) RETURNING id, run_id, kind, target AS \"target: Json\", state AS \"state: TaskState\", attempts, worker_id, error, claimed_at, finished_at",

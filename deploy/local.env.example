# Local secrets for `docker compose -f deploy/docker-compose.yml --env-file deploy/local.env up`.
#
# Copy to `deploy/local.env` and fill in. That file is gitignored and MUST stay untracked:
# an earlier revision of it held a live AniList client secret and a live AES-256 data
# encryption key, which is why every value below is a placeholder.
#
# Note the `KEY=value` form. An earlier version of this file used YAML `KEY: "value"`, which
# docker's env-file parser reads as a variable literally named `KEY` — the values were never
# applied at all.

# ---------------------------------------------------------------------------
# Internal service-to-service authentication (required in production)
# ---------------------------------------------------------------------------
# One shared secret, identical on api, sync, control-plane, render and challenge-solver.
# Without it those services accept privileged calls from anything that can reach the port.
#   openssl rand -hex 32
TANKOVAULT_INTERNAL__TOKEN=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# At least 32 bytes. The known dev placeholder is rejected at boot in every profile.
#   openssl rand -hex 32
TANKOVAULT_AUTH__JWT_SECRET=
# Server-side pepper mixed into every argon2id hash. Rotating it invalidates all passwords.
#   openssl rand -hex 32
TANKOVAULT_AUTH__PASSWORD_PEPPER=
# Initial administrator password for the one-shot `seed` step. Change on first sign-in.
TANKOVAULT_SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# AniList OAuth (external sync)
# ---------------------------------------------------------------------------
# Register an application at https://anilist.co/settings/developer and paste its values.
TANKOVAULT_ANILIST__CLIENT_ID=
TANKOVAULT_ANILIST__CLIENT_SECRET=
# Base64 32 bytes. Seals every user's AniList access/refresh token at rest — losing it means
# every linked account must re-link; leaking it means every stored token is readable.
#   openssl rand -base64 32
TANKOVAULT_ANILIST__TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Transactional email (optional; unset ⇒ no-op mailer, those flows skip sending)
# ---------------------------------------------------------------------------
TANKOVAULT_EMAIL__HOST=
TANKOVAULT_EMAIL__PORT=587
TANKOVAULT_EMAIL__SECURITY=starttls
TANKOVAULT_EMAIL__USERNAME=
TANKOVAULT_EMAIL__PASSWORD=
TANKOVAULT_EMAIL__FROM=

{
  "db_name": "PostgreSQL",
  "query": "SELECT d.id, d.run_id, d.decided_at, d.user_id, u.username, d.series_id, s.canonical_title AS series_title, d.provider, d.external_id, d.scope, d.action, d.reason, d.policy, d.applied, d.local_before, d.local_after, d.remote_before, d.remote_after, d.ancestor_local, d.ancestor_remote, d.match_score, d.match_signals, d.evidence, d.reverted_at, d.reverted_by, d.revert_reason, d.flagged_at, d.flagged_by, d.flag_reason FROM sync_decisions d LEFT JOIN series s ON s.id = d.series_id LEFT JOIN users  u ON u.id = d.user_id WHERE ($3::uuid IS NULL OR d.user_id = $3) AND ($4::uuid IS NULL OR d.series_id = $4) AND ($5::text IS NULL OR d.provider = $5) AND ($6::text IS NULL OR d.action = $6) AND ($7::uuid IS NULL OR d.run_id = $7) AND (NOT $8::boolean OR d.applied) AND (NOT $9::boolean OR d.flagged_at IS NOT NULL) ORDER BY d.decided_at DESC LIMIT $1 OFFSET $2",

{
  "terrace_contract": 1,
  "app": {
    "name": "tankovault-bootstrap",
    "version": "v8.9.3",
    "source": "https://github.com/TimSchoenle/TankoVault"
  },
  "schema": {
    "schema_version": 2,
    "dialect": {
      "prefix": "TANKOVAULT_",
      "nesting_separator": "__",
      "indirection_suffix": "_FILE"
    },
    "loader": [
      {
        "env": "TANKOVAULT_CONFIG",
        "role": "config",
        "docs": "Names the TOML layer: a file, or a directory whose `*.toml` files are all merged in name order.",
        "default": "config.toml"
      },
      {
        "env": "TANKOVAULT_SECRETS_DIR",
        "role": "secrets_dir",
        "docs": "Names a directory of key-named files — a mounted Kubernetes `Secret` volume. Each file supplies the key its name spells.",
        "default": null
      },
      {
        "env": "TANKOVAULT_PROFILE",
        "role": "reserved",
        "docs": "Read directly from the environment before the layered config exists, so no file may supply it.",
        "default": null
      },
      {
        "env": "TANKOVAULT_CONFIRM_RESET",
        "role": "reserved",
        "docs": "Read directly from the environment before the layered config exists, so no file may supply it.",
        "default": null
      }
    ],
    "keys": [
      {
        "path": "database.url",
        "env": "TANKOVAULT_DATABASE__URL",
        "env_file": "TANKOVAULT_DATABASE__URL_FILE",
        "secrets_file": "database__url",
        "docs": "e.g. `postgres://user:pass@host:5432/tankovault`.\n\nA [`SecretString`]: the DSN carries the password, and this struct's `Debug` is nested\ninside state routinely logged with `?`.",
        "ty": "SecretString",
        "values": [],
        "constraint": {
          "type": "string"
        },
        "text_form": "text",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": true,
        "secret": true,
        "reserved": false
      },
      {
        "path": "database.max_connections",
        "env": "TANKOVAULT_DATABASE__MAX_CONNECTIONS",
        "env_file": "TANKOVAULT_DATABASE__MAX_CONNECTIONS_FILE",
        "secrets_file": "database__max_connections",
        "docs": "Upper bound on the connection pool.",
        "ty": "u32",
        "values": [],
        "constraint": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "text_constraint": {
          "pattern": "^\\s*\\+?[0-9]+\\s*$",
          "type": "string"
        },
        "text_form": "integer",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": false,
        "secret": false,
        "reserved": false
      },
      {
        "path": "database.acquire_timeout_secs",
        "env": "TANKOVAULT_DATABASE__ACQUIRE_TIMEOUT_SECS",
        "env_file": "TANKOVAULT_DATABASE__ACQUIRE_TIMEOUT_SECS_FILE",
        "secrets_file": "database__acquire_timeout_secs",
        "docs": "Statement/acquire timeout, seconds.",
        "ty": "u64",
        "values": [],
        "constraint": {
          "minimum": 0,
          "type": "integer"
        },
        "text_constraint": {
          "pattern": "^\\s*\\+?[0-9]+\\s*$",
          "type": "string"
        },
        "text_form": "integer",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": false,
        "secret": false,
        "reserved": false
      },
      {
        "path": "auth.password_pepper",
        "env": "TANKOVAULT_AUTH__PASSWORD_PEPPER",
        "env_file": "TANKOVAULT_AUTH__PASSWORD_PEPPER_FILE",
        "secrets_file": "auth__password_pepper",
        "docs": "Server-side password pepper: mixed into every argon2id hash so a leak alone can't be\nbrute-forced offline. Empty (default) is un-peppered, for compatibility with old\nhashes; once configured it must stay stable or passwords stop verifying.",
        "ty": "SecretString",
        "values": [],
        "constraint": {
          "type": "string"
        },
        "text_form": "text",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": false,
        "secret": true,
        "reserved": false
      },
      {
        "path": "seed_admin_email",
        "env": "TANKOVAULT_SEED_ADMIN_EMAIL",
        "env_file": "TANKOVAULT_SEED_ADMIN_EMAIL_FILE",
        "secrets_file": "seed_admin_email",
        "docs": "Address of the account to seed. An account already holding it is left untouched.",
        "ty": "String",
        "values": [],
        "constraint": {
          "type": "string"
        },
        "text_form": "text",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": false,
        "secret": false,
        "reserved": false
      },
      {
        "path": "seed_admin_username",
        "env": "TANKOVAULT_SEED_ADMIN_USERNAME",
        "env_file": "TANKOVAULT_SEED_ADMIN_USERNAME_FILE",
        "secrets_file": "seed_admin_username",
        "docs": "Name of the account to seed. An account already holding it is left untouched.",
        "ty": "String",
        "values": [],
        "constraint": {
          "type": "string"
        },
        "text_form": "text",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": false,
        "secret": false,
        "reserved": false
      },
      {
        "path": "seed_admin_password",
        "env": "TANKOVAULT_SEED_ADMIN_PASSWORD",
        "env_file": "TANKOVAULT_SEED_ADMIN_PASSWORD_FILE",
        "secrets_file": "seed_admin_password",
        "docs": "No default, unlike `xtask seed`: a published image must not be able to create an account\nwhose password is written down in this repository.",
        "ty": "SecretString",
        "values": [],
        "constraint": {
          "type": "string"
        },
        "text_form": "text",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": false,
        "secret": true,
        "reserved": false
      }
    ]
  },
  "json_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "auth": {
        "additionalProperties": false,
        "properties": {
          "password_pepper": {
            "description": "Server-side password pepper: mixed into every argon2id hash so a leak alone can't be\nbrute-forced offline. Empty (default) is un-peppered, for compatibility with old\nhashes; once configured it must stay stable or passwords stop verifying.",
            "type": "string",
            "writeOnly": true
          }
        },
        "type": "object"
      },
      "database": {
        "additionalProperties": false,
        "properties": {
          "acquire_timeout_secs": {
            "description": "Statement/acquire timeout, seconds.",
            "minimum": 0,
            "type": "integer"
          },
          "max_connections": {
            "description": "Upper bound on the connection pool.",
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "url": {
            "description": "e.g. `postgres://user:pass@host:5432/tankovault`.\n\nA [`SecretString`]: the DSN carries the password, and this struct's `Debug` is nested\ninside state routinely logged with `?`.",
            "type": "string",
            "writeOnly": true
          }
        },
        "type": "object"
      },
      "seed_admin_email": {
        "description": "Address of the account to seed. An account already holding it is left untouched.",
        "type": "string"
      },
      "seed_admin_password": {
        "description": "No default, unlike `xtask seed`: a published image must not be able to create an account\nwhose password is written down in this repository.",
        "type": "string",
        "writeOnly": true
      },
      "seed_admin_username": {
        "description": "Name of the account to seed. An account already holding it is left untouched.",
        "type": "string"
      }
    },
    "title": "tankovault-bootstrap configuration",
    "type": "object"
  },
  "external": {
    "env": [
      {
        "name": "RUST_LOG",
        "owner": "tracing",
        "docs": "Verbosity, as `tracing` directives — `info`, `tankovault_api=debug,info`. Read by `EnvFilter::try_from_default_env`, which is consulted *before* `telemetry.log_filter` and wins over it when set.",
        "ty": "String",
        "values": [],
        "constraint": {
          "type": "string"
        },
        "text_form": "text",
        "required": false,
        "secret": false
      }
    ],
    "ignore": [
      "KUBERNETES_*",
      "HOSTNAME"
    ],
    "unknown": "reject"
  }
}

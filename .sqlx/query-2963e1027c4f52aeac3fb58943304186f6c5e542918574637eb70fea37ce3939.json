{
  "db_name": "PostgreSQL",
  "query": "SELECT t.id, t.run_id, t.kind, t.target FROM scan_tasks t JOIN scan_runs r ON r.id = t.run_id WHERE r.provider_id = $1 AND r.mode = $2::scan_mode AND r.state IN ('queued','running') AND t.state IN ('queued','claimed','running') AND (t.created_at IS NULL OR t.created_at < now() - make_interval(secs => $3)) ORDER BY t.created_at ASC NULLS FIRST LIMIT $4",

{
  "uid": "tankovault-overview",
  "title": "TankoVault Service Overview",
  "description": "Every panel here is backed by a metric the workspace actually emits (see docs/OBSERVABILITY.md for the inventory) and, wherever possible, by a recording rule rather than an ad-hoc query. Panels that would need a metric nobody emits are deliberately absent rather than present and empty.",
  "tags": ["tankovault"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
        "query": "label_values(up{job!~\"prometheus|readiness|blackbox-exporter\"}, job)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Firing alerts",
        "enable": true,
        "iconColor": "red",
        "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
        "expr": "ALERTS{alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} on {{job}}{{service}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Replicas answering a scrape",
      "description": "One per service, except worker, which docker-compose.yml declares with replicas: 2. A service missing from this panel entirely is down, not idle.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 6, "w": 9, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "job:replicas:count",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Readiness (GET /ready via blackbox)",
      "description": "The only signal that reports on dependencies: Postgres reachable, NATS reachable, and for the frontend the api upstream. Not ready means curl the service's /ready for the per-dependency body.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 6, "w": 9, "x": 9, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "service:ready:min",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "not ready", "color": "red", "index": 0 },
                "1": { "text": "ready", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Firing alerts",
      "description": "There is no Alertmanager in this stack on purpose (see the note in prometheus.yml), so this panel and Prometheus' own Alerts page are where a firing rule is seen.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "sort_desc(ALERTS{alertstate=\"firing\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true, "alertstate": true, "instance": true },
            "renameByName": { "alertname": "Alert", "severity": "Severity" }
          }
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Request path",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Request rate by service",
      "description": "http_requests_total from the shared middleware. Health and readiness probes are absent by design: ops_router is merged outside HttpStack, so probe traffic never enters this counter.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "job:http_requests:rate5m{job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "5xx ratio by service",
      "description": "Every client-side outcome in this API is a 4xx (401, 403, 404 feature_disabled, 409, 429), so a healthy deployment sits at zero here rather than merely low. Gaps are idle periods: the ratio is NaN while there is no traffic, which is deliberate.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "job:http_requests_server_errors:ratio_rate5m{job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Latency quantiles by service",
      "description": "Computed from explicit histogram buckets, aggregated across replicas before the quantile is taken. The dashed reference lines are the TankoVaultLatencyDegraded (2.5s) and TankoVaultLatencyCritical (10s) thresholds, both of which are real bucket boundaries.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "job:http_request_duration_seconds:p50_5m{job=~\"$job\"}",
          "legendFormat": "{{job}} p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "job:http_request_duration_seconds:p95_5m{job=~\"$job\"}",
          "legendFormat": "{{job}} p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "job:http_request_duration_seconds:p99_5m{job=~\"$job\"}",
          "legendFormat": "{{job}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2.5 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Slowest routes (p95, /v1/me/stream excluded)",
      "description": "The SSE stream is excluded because a server-closed stream records a multi-minute duration in the +Inf bucket and poisons every quantile for the api job. Route labels are axum matched paths, so ids never appear here; unmatched folds together everything that hit no route, which on the frontend job is the static bundle.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "topk(10, job_route:http_request_duration_seconds:p95_5m{job=~\"$job\"})",
          "legendFormat": "{{job}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "5xx by route",
      "description": "Where to start when TankoVaultHighServerErrorRatio fires. Pair a route here with the request id in the JSON logs.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "topk(10, job_route:http_requests_server_errors:rate5m{job=~\"$job\"} > 0)",
          "legendFormat": "{{job}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Concurrent requests in flight",
      "description": "Deliberately NOT alerted on. On api and frontend an open /v1/me/stream is legitimately one request in flight for as long as the browser tab is open, so this gauge tracks connected clients as much as load. Read it against the request-rate panel: concurrency rising while throughput stays flat is queueing, which on this stack means the database pool.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "job:http_requests_in_flight:avg{job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Edge policy: rate limiting and feature gating",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Requests refused by the rate limiter",
      "description": "By class. auth covers login, register, reset and refresh and is the credential-guessing control: sustained traffic there is the signal, not the global class.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "job_class:http_rate_limited:rate5m{job=~\"$job\"}",
          "legendFormat": "{{job}} {{class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Rate limiter store failures (limiter is failing OPEN)",
      "description": "The Redis backend fails open on purpose so a counter-store outage cannot take the edge down. Any non-zero value here means the configured limits are not being enforced at all, including the auth class.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "job_backend:rate_limit_store_errors:rate5m{job=~\"$job\"}",
          "legendFormat": "{{job}} {{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.0001 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Requests for switched-off features",
      "description": "Answered 404 feature_disabled. Non-zero right after a flag change is expected; still non-zero an hour later means a client is not honouring /v1/me/capabilities.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 33 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "job_feature:http_feature_disabled:rate15m{job=~\"$job\"}",
          "legendFormat": "{{job}} {{feature}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Scan pipeline",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Scan tasks served per provider lane",
      "description": "Round-robin fairness within a tier predicts these climb together while several providers have work. One provider climbing alone means either the others' lanes are empty or they failed to open (grep the worker log for 'could not open provider task lane'). A redelivered task counts again, so a failing provider can also produce a lone climb.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "provider_scan:scan_tasks_served:rate5m",
          "legendFormat": "{{provider}} {{scan}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Scan tasks served per tier",
      "description": "Fast scans surface new chapters; full scans rebuild the catalogue. Fast has strict priority, so a flat fast line while full is busy is a lane failure, not a queueing effect. That is TankoVaultFastScanLanesStarved.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 42 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "scan:scan_tasks_served:rate15m",
          "legendFormat": "{{scan}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 33,
      "type": "bargauge",
      "title": "Tasks served per provider, last hour",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 42 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "provider:scan_tasks_served:increase1h",
          "legendFormat": "{{provider}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] }
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Scan queue depth per provider lane",
      "description": "Messages waiting on each durable consumer, from JetStream. This is the only backlog signal in the stack: scan_tasks_served_total counts tasks handed out, so from the worker's side a wedged pipeline and an empty one look the same. Read against the throughput panel: depth flat and non-zero while throughput is zero means nothing is being consumed.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 50 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "provider_scan:scan_queue_depth:current",
          "legendFormat": "{{provider}} {{scan}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "Redelivered tasks, and the notifier backlog",
      "description": "Redelivered-and-unacked per lane: MAX_TASK_DELIVERIES is 3, so a lane holding these continuously is failing rather than hiccupping. The events-stream depth is the notifier's own backlog, which stops draining when a channel hangs (an SMTP relay that accepts and never answers) because the notifier acks only after fan-out.",
      "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 50 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "provider_scan:scan_tasks_redelivered:current",
          "legendFormat": "redelivered: {{provider}} {{scan}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "tankovault-prometheus" },
          "expr": "consumer:events_queue_depth:current",
          "legendFormat": "events queue: {{consumer_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {

# Text normalisation, diff drivers, and linguist classification for this repository.
#
# Every `linguist-generated=true` entry also carries `eol=lf` on the same line: xtask
# repo-lint's `generated-artefacts-eol` rule (xtask/src/repo_lint/gitattributes.rs) enforces
# that pairing, because the gates guarding these files compare bytes and every generator
# writes `\n`.

* text=auto

# --- Rust workspaces (root, web/frontend, web/frontend/crates/inkstone-ui, xtask) ----------
*.rs   text diff=rust
*.toml text

# --- Frontend sources -----------------------------------------------------------------------
*.css  text diff=css
*.html text diff=html
*.hbs  text

# --- Documentation ---------------------------------------------------------------------------
*.md              text diff=markdown
docs/**/*.md      linguist-documentation=true
deploy/legal/*.md linguist-documentation=true

# --- Structured data, SQL, and env files ------------------------------------------------------
*.json text eol=lf
*.sql  text eol=lf
*.env      text eol=lf
*.example  text eol=lf

# --- Scripts and containers: must check out LF whatever core.autocrlf says -------------------
*.sh             text eol=lf diff=bash
justfile         text eol=lf diff=bash
xtask/hooks/*    text eol=lf diff=bash
Dockerfile*      text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf

# --- Generated artefacts: regenerate via xtask/npm/release-please, never hand-edit -----------
openapi.json                   linguist-generated=true -diff eol=lf
crates/api-client/src/lib.rs   linguist-generated=true -diff eol=lf
.sqlx/*.json                   linguist-generated=true -diff eol=lf
THIRD-PARTY-NOTICES            linguist-generated=true -diff eol=lf
web/frontend/assets/main.css   linguist-generated=true eol=lf
web/frontend/package-lock.json linguist-generated=true eol=lf
README.md                      linguist-generated=true eol=lf
.release-please-manifest.json  linguist-generated=true eol=lf

# Lockfiles are generated too, but kept diff-able on purpose: a dependency change is exactly
# what a reviewer should read, since it is how a dependency actually enters the build.
Cargo.lock linguist-generated=true eol=lf

# The published configuration contracts: diff-able on purpose, a removed or renamed key is
# exactly what a reviewer of this diff should be reading.
docs/contracts/*.json linguist-generated=true eol=lf

# --- Binary assets: never line-ending-converted, never diffed as text ------------------------
*.woff2 binary
*.ico   binary
*.png   binary

# --- Adapter fixtures: captured third-party HTML/JSON/XML, not ours to author or to count
# towards this repository's language statistics.
crates/adapters/fixtures/** linguist-vendored=true -diff

# --- Fuzzing inputs are byte-exact: `text=auto` would silently rewrite CRLF/LF on checkout,
# so a Windows and a Linux corpus would stop being the same bytes for the same commit.
fuzz/seeds/**            -text
fuzz/corpus/**           -text
fuzz/dictionaries/*.dict text eol=lf

# --- proptest regression seeds: append-only failure corpus, kept diffable --------------------
*.proptest-regressions     text eol=lf
**/proptest-regressions/** text eol=lf

  "query": "SELECT mc.id, mc.series_id, s1.canonical_title AS series_title, mc.candidate_id, s2.canonical_title AS candidate_title, mc.score, mc.reason, mc.created_at FROM merge_candidates mc JOIN series s1 ON s1.id = mc.series_id JOIN series s2 ON s2.id = mc.candidate_id WHERE NOT mc.resolved ORDER BY mc.created_at DESC LIMIT $1",

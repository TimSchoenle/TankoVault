# syntax=docker/dockerfile:1
#
# Multi-stage, cargo-chef-cached build for any TankoVault service binary. Select which one
# with `--build-arg BIN=<name>`:
#   api · worker · control-plane · notifier · sync · challenge-solver · render · xtask
#
# Runtime image
# -------------
# Every non-browser binary is compiled as a **fully static musl binary** (no glibc, no
# dynamic loader) and shipped on a bare `scratch` image: no shell, no package manager, no OS
# — just the binary plus a CA trust store. This is the smallest and most attack-surface-free
# runtime possible. The `render` tier drives a real headless Chromium (chromiumoxide, design
# §9), which `scratch` cannot host, so it uses the dedicated Debian `runtime-browser` stage
# (`--target runtime-browser`).
#
# Caching
# -------
# The dependency graph is compiled once by cargo-chef (the `cook` layer) and reused across
# source changes and across every service image; that layer is what CI exports/imports via
# the GHA cache. On top of it, BuildKit `type=cache` mounts keep the downloaded crate
# registry/git checkouts warm across local rebuilds.
#
# Reproducibility
# ---------------
# Base images are pinned by digest, cargo resolves against the committed `Cargo.lock`
# (`--locked`), and image layer timestamps are clamped to `SOURCE_DATE_EPOCH` when supplied
# (`--build-arg SOURCE_DATE_EPOCH=$(git log -1 --format=%ct)`). Together with the release
# profile (`strip`, `panic=abort`, `codegen-units=1`) this yields byte-stable images.

ARG RUST_VERSION=1.94
# Fully static target: the produced binary has no dynamic dependencies, so it runs on
# `scratch`. Overridable for cross-arch builds (e.g. aarch64-unknown-linux-musl).
ARG BUILD_TARGET=x86_64-unknown-linux-musl
# Passed through so BuildKit can clamp layer mtimes for reproducible images. Empty is fine.
ARG SOURCE_DATE_EPOCH

# --- Toolchain: cargo-chef + the musl cross target. --------------------------------
# Pinned by digest for reproducible, tamper-evident builds. The `${RUST_VERSION}` tag is
# kept in the reference for readability; the digest is what is actually resolved. Refresh
# with: docker buildx imagetools inspect lukemathwalker/cargo-chef:latest-rust-1.94-bookworm
FROM lukemathwalker/cargo-chef:latest-rust-${RUST_VERSION}-bookworm@sha256:7e550e59b8c14e74aa86ca9e5950b75d937c9d51e7f5a4c840e726a33b4b8455 AS chef
WORKDIR /app
ARG BUILD_TARGET
# The musl std target plus its C toolchain (`musl-tools` → `musl-gcc`, needed by the `ring`
# build script), and a CA bundle we later bake into the certificate-less `scratch` image.
RUN rustup target add "${BUILD_TARGET}" \
 && apt-get update \
 && apt-get install -y --no-install-recommends musl-tools ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# --- Plan: capture the dependency recipe from the whole workspace. -----------------
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# --- Build: cook deps (cached), then compile the requested binary statically. -------
FROM chef AS builder
# The `tankovault-db` repositories use sqlx's compile-time-checked query macros. There is
# no database in the build sandbox, so the macros are resolved from the committed offline
# query cache (`.sqlx/`, generated by `cargo sqlx prepare`) instead of a live connection.
ENV SQLX_OFFLINE=true
ARG BUILD_TARGET
COPY --from=planner /app/recipe.json recipe.json
# Cook the dependency graph for the musl target. The `--mount=type=cache` mounts keep the
# crate registry/git downloads warm across local rebuilds; the compiled artefacts still land
# in the image layer so cargo-chef's cross-build cache (and the CI GHA cache) keep working.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo chef cook --release --locked --target "${BUILD_TARGET}" --recipe-path recipe.json
COPY . .
# `BIN` is declared here (after cook) so changing it does not bust the dependency cache.
ARG BIN
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release --locked --target "${BUILD_TARGET}" --bin "${BIN}" \
 && cp "target/${BUILD_TARGET}/release/${BIN}" /app/service

# --- Runtime (browser): Debian slim + Chromium for the optional `render` service. ---
# The render tier drives a real headless browser (chromiumoxide, design §9), which the
# `scratch` image cannot provide; build it with `--target runtime-browser`. The service
# binary is static musl and runs unchanged on Debian.
FROM debian:12-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818 AS runtime-browser
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      chromium ca-certificates fonts-liberation \
 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/service /usr/local/bin/tankovault-service
# Point chromiumoxide at the distro Chromium and run it without the sandbox (no user
# namespaces inside the container). Consumed by the render service's config.
ENV TANKOVAULT_RENDER__CHROME_PATH=/usr/bin/chromium \
    TANKOVAULT_RENDER__NO_SANDBOX=true
ENTRYPOINT ["/usr/local/bin/tankovault-service"]

# --- Runtime: scratch (static musl binary), nonroot. --------------------------------
# This is the DEFAULT target for every non-browser service; keep it last. `scratch` has no
# filesystem at all, so we bake in exactly two things: the CA trust store (needed by the
# rustls/reqwest/lettre clients to validate outbound TLS to providers, AniList and SMTP) and
# the binary itself.
FROM scratch AS runtime
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /app/service /usr/local/bin/tankovault-service
# Numeric nonroot UID:GID (scratch ships no /etc/passwd); mirrors distroless `nonroot`.
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/tankovault-service"]

{
  "name": "tankovault-frontend-css",
  "version": "0.1.0",
  "private": true,
  "description": "Dev-only Tailwind v4 CSS build for the TankoVault Dioxus SPA. Not shipped in the WASM bundle; produces the committed assets/main.css.",
  "scripts": {
    "css:build": "tailwindcss -i ./input.css -o ./assets/main.css --minify",
    "css:watch": "tailwindcss -i ./input.css -o ./assets/main.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}

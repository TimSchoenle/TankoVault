  "json_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "bind_addr": {
        "type": "string"
      },
      "internal": {
        "additionalProperties": false,
        "properties": {
          "caller": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "The name peers know this service by; must match the key they list it under.",
                "type": "string"
              },
              "token": {
                "description": "Presented to peers under `identity = \"token\"`. Ignored under `mtls`, where the client\ncertificate is the credential.",
                "type": "string",
                "writeOnly": true
              }
            },
            "type": "object"
          },
          "identity": {
            "description": "How callers are identified. See [`IdentityMode`].",
            "enum": [
              "off",
              "token",
              "mtls"
            ],
            "type": "string"
          },
          "peers": {
            "description": "Which services may call this one, keyed by caller name.",
            "type": "object"
          },
          "tls": {
            "additionalProperties": false,
            "properties": {
              "ca": {
                "description": "PEM bundle of the authorities a peer certificate must chain to.",
                "type": "string"
              },
              "cert": {
                "description": "PEM certificate chain this service serves and presents.",
                "type": "string"
              },
              "key": {
                "description": "PEM private key for [`Self::cert`].",
                "type": "string"
              },
              "probe_listen": {
                "description": "Address the credential-free `/health` and `/ready` probes bind to, in **plaintext**, on\ntheir own listener (default `0.0.0.0:9091`). Read under `mtls` only.\n\nAn orchestrator probe presents no client certificate, so on the mTLS port its plain\n`GET` is answered with a TLS alert rather than a response and the replica is restarted\nas unhealthy. `null` drops the listener, which is right only where whatever does the\nprobing *can* present a certificate.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "token": {
            "description": "The retired tier-wide shared secret. Present only so a deployment that still sets it is\ntold what to do instead; see [`InternalAuthConfig::resolve`].",
            "type": "string",
            "writeOnly": true
          }
        },
        "type": "object"
      },
      "metrics": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "description": "Install the Prometheus recorder and serve the scrape endpoint. When `false` the\nscrape route answers `404` and no measurements are retained.",
            "type": "boolean"
          },
          "http_requests": {
            "description": "Also record per-request HTTP metrics. Separate from [`Self::enabled`]: the request\nhistogram is the expensive, high-cardinality part.",
            "type": "boolean"
          },
          "listen": {
            "description": "Address the scrape endpoint binds to on its **own** listener (default `0.0.0.0:9090`),\nisolated from the service's public port. `None` merges it onto the primary port.",
            "type": "string"
          },
          "route": {
            "description": "Path the scrape endpoint is mounted at.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "rate_limit": {
        "additionalProperties": false,
        "properties": {
          "auth": {
            "additionalProperties": false,
            "properties": {
              "burst": {
                "description": "Bucket depth: the most requests a client may spend back-to-back.",
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              "per_minute": {
                "description": "Sustained requests allowed per minute per client key; the bucket's refill rate.",
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "backend": {
            "description": "Counter store. See [`RateLimitBackend`].",
            "enum": [
              "memory",
              "redis"
            ],
            "type": "string"
          },
          "enabled": {
            "description": "Enforce limits. When `false` the layer is not mounted at all (no per-request cost).",
            "type": "boolean"
          },
          "expensive": {
            "additionalProperties": false,
            "properties": {
              "burst": {
                "description": "Bucket depth: the most requests a client may spend back-to-back.",
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              "per_minute": {
                "description": "Sustained requests allowed per minute per client key; the bucket's refill rate.",
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "global": {
            "additionalProperties": false,
            "properties": {
              "burst": {
                "description": "Bucket depth: the most requests a client may spend back-to-back.",
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              "per_minute": {
                "description": "Sustained requests allowed per minute per client key; the bucket's refill rate.",
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "trust_forwarded_for": {
            "description": "Trust `X-Forwarded-For`/`X-Real-IP` for the client key. **Only behind a reverse proxy\nthat overwrites these** — otherwise any client can forge a fresh identity and bypass\nthe limiter.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "security": {
        "additionalProperties": false,
        "properties": {
          "cors": {
            "additionalProperties": false,
            "properties": {
              "allow_credentials": {
                "description": "Allow credentialed cross-origin requests (cookies, `Authorization`). Cannot combine\nwith a wildcard origin.",
                "type": "boolean"
              },
              "allowed_origins": {
                "description": "Exact origins allowed, e.g. `https://app.example.com`. Empty disables CORS entirely.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "max_age_secs": {
                "description": "`Access-Control-Max-Age`, seconds.",
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "expose_api_docs": {
            "description": "Serve the browsable API docs (`/scalar`) and the `OpenAPI` document.\n\nDefaults off in production, on elsewhere (hence a function, not a literal): left on,\nit hands an attacker the whole admin surface — every `/v1/admin/*` path, the\npermission vocabulary, exact request bodies — with no failed probe.",
            "type": "boolean"
          },
          "hsts": {
            "description": "Emit `Strict-Transport-Security`; meaningless without TLS (browsers ignore it over\nplain HTTP).",
            "type": "boolean"
          },
          "hsts_max_age_secs": {
            "description": "`max-age` for the HSTS header, seconds (default: two years, the preload minimum).",
            "minimum": 0,
            "type": "integer"
          },
          "max_body_bytes": {
            "description": "Reject request bodies larger than this, in bytes, before they are buffered.",
            "minimum": 0,
            "type": "integer"
          },
          "request_timeout_secs": {
            "description": "Abort a request that has not produced a response within this many seconds.",
            "minimum": 0,
            "type": "integer"
          },
          "security_headers": {
            "description": "Send the baseline set of hardening headers (`X-Content-Type-Options`,\n`X-Frame-Options`, `Referrer-Policy`, `Cross-Origin-Resource-Policy`).",
            "type": "boolean"
          },
          "trust_request_id": {
            "description": "Accept an inbound `X-Request-Id` instead of minting one. Requires a trusted proxy —\na client-supplied id could otherwise poison log correlation.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "solver": {
        "additionalProperties": false,
        "properties": {
          "backend": {
            "description": "Back-end selector; only `trawl` is wired today.",
            "type": "string"
          },
          "max_timeout_ms": {
            "minimum": 0,
            "type": "integer"
          },
          "session_ttl_secs": {
            "description": "How long *this* deployment caches a solved session for. Independent of TRAWL's own\n`SESSION_TTL_SECONDS`, which governs the cookie jar it replays internally.",
            "minimum": 0,
            "type": "integer"
          },
          "trawl_endpoint": {
            "description": "TRAWL base endpoint, e.g. `http://trawl:8191`.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "telemetry": {
        "additionalProperties": false,
        "properties": {
          "json_logs": {
            "description": "Emit structured JSON logs (production) vs. pretty logs (dev).",
            "type": "boolean"
          },
          "log_filter": {
            "description": "**`TANKOVAULT_TELEMETRY__OTLP_ENDPOINT` is removed** (it silently did nothing); setting\nit is now a hard config error. Re-add only with a real `OpenTelemetryLayer`.\n\n`RUST_LOG`-style filter (e.g. `info,tankovault=debug`).",
            "type": "string"
          },
          "service_name": {
            "description": "Logical service name reported in traces/metrics.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "title": "tankovault-challenge-solver configuration",
    "type": "object"
  },
  "external": {
    "env": [
      {
        "name": "RUST_LOG",
        "owner": "tracing",
        "docs": "Verbosity, as `tracing` directives — `info`, `tankovault_api=debug,info`. Read by `EnvFilter::try_from_default_env`, which is consulted *before* `telemetry.log_filter` and wins over it when set.",
        "ty": "String",
        "values": [],
        "constraint": {
          "type": "string"
        },
        "text_form": "text",
        "required": false,
        "secret": false
      }
    ],
    "ignore": [
      "KUBERNETES_*",
      "HOSTNAME"
    ],
    "unknown": "reject"
  }
}
